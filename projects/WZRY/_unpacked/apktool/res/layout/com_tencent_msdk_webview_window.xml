            <ImageButton android:id="@id/forwardUnclickable" android:background="@drawable/com_tencent_msdk_webview_btn_bg" android:paddingLeft="@dimen/thrdcall_btn_margin" android:paddingRight="@dimen/thrdcall_btn_margin" android:clickable="false" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/com_tencent_msdk_webview_right_unclickable" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
