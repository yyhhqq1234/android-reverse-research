            <ImageButton android:id="@id/refresh" android:background="@drawable/com_tencent_msdk_webview_btn_bg" android:paddingLeft="@dimen/thrdcall_btn_margin" android:paddingRight="@dimen/thrdcall_btn_margin" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/com_tencent_msdk_webview_refresh" />
        </LinearLayout>
        <LinearLayout android:id="@id/land_layout_qqbrowser" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
