        </LinearLayout>
        <LinearLayout android:gravity="right" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_weight="1.0">
            <LinearLayout android:id="@id/return_app" android:background="@drawable/com_tencent_msdk_webview_btn_bg" android:paddingLeft="5.0dp" android:paddingRight="5.0dp" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="@dimen/thrdcall_btn_margin" android:layout_marginRight="@dimen/thrdcall_btn_margin">
                <ImageButton android:background="@null" android:layout_width="wrap_content" android:layout_height="match_parent" android:src="@drawable/com_tencent_msdk_webview_close" />
                <TextView android:textSize="16.0dp" android:textColor="#ffffffff" android:gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginLeft="5.0dp" android:text="返回游戏" />
            </LinearLayout>
