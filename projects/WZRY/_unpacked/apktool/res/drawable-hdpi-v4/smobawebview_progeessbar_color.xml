<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <shape>
                <gradient android:startColor="#1a21a8e0" android:endColor="#ff21a8e0" android:angle="0.0" />
            </shape>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="8.0dp" />
                <gradient android:startColor="#ff19ab67" android:endColor="#ff19ab67" android:angle="270.0" />
            </shape>
        </clip>
    </item>
</layer-list>
