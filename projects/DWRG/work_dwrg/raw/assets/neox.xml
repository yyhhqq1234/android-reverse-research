<ppg3d>
	<modules>
		<module
			Name		= 'Python'
			File		= 'python.dll'
		/>
		<module
			Name		= 'Collision'
			File		= 'collision.dll'
		/>
	</modules>
	<client
		ResourceRoot		= '.\res'
		LimitDisplayRate	= 'False'
		ShowLogWindow		= 'True'
		DumpType		= '0'
		DumpPath		= 'dumps'
		ShowDumpDlg		= 'False'
		World			= 'mix'
		WindowClientWidth	= '850'
		WindowClientHeight	= '550'
		>
	</client>
	<render
		Depth			= '32'
		MultiSample		= '0'
		VSync			= 'False'
		OneLightOptimize = 'False'
		UseClassifiedVertexPool = 'True'
		EnableShadowMap = 'True'
		RedirectBackbuffer = 'False'
        EnableRenderThread = 'True'
		>
	</render>
	<world
		MergeStaticModel = 'True'
		GpuSkinningEnable = 'False'
		PixelDecal = 'False'
		GpuParticle = 'False'
		MergeDynamicModel = 'True'
		SubMeshBatching = 'True'
		EnableVegetation = 'True'
		HardwareInstancing = 'True'
        EnableOpenWorldLod = 'True'
		EnableAnimationThread = 'False'
		>
	</world>
	<filesystems>
		<filesystem name='res'>
			<loader name='npk' opener='sys' root='%DOC_DIR%\\res' depth = '0'/>
			<loader name='discrete' opener='sys' root='%DOC_DIR%\\res' depth="0"/>
			<loader name='npk' opener='sys' root='%WORK_DIR%\\res' depth = '0'/>
			<loader name='discrete' opener='sys' root='%WORK_DIR%\\res' depth="0"/>
		</filesystem>
		<filesystem name="script">
			<loader name='npk' opener='sys' root='%DOC_DIR%\\script' depth = '0'/>
			<loader name="discrete" opener="sys" root="%DOC_DIR%\\script" depth="0"/>
			<loader name='npk' opener='sys' root='%WORK_DIR%\\script' depth = '0'/>
			<loader name="discrete" opener="sys" root="%WORK_DIR%\\script" depth="0"/>
		</filesystem>
	</filesystems>
	<cocosui LogLevel = '30' EnableBatchOptimize = "True"/>
	<cocosui>
		<FontNameMap>
		<FontNameMap0 Name = '微软雅黑' Value = 'fzhtjw.ttf' />
		</FontNameMap>
	</cocosui>
	<profiling
        PerfSystem = 'True'
        DebugPort = '17777'
    >
    </profiling>
    <python
        ThreadEnable        = 'True'
        >
    </python>
</ppg3d>
