<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NeteaseMpay.Login.LoginTheme" parent="@style/NeteaseMpay.Login.AppTheme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="NeteaseMpay.Login.Widget.EditText.ImeNext" parent="@android:style/Widget.EditText">
        <item name="android:imeOptions">actionNext|flagNoExtractUi</item>
    </style>
    <style name="NeteaseMpay.Login.Widget.EditText.ImeDone" parent="@android:style/Widget.EditText">
        <item name="android:imeOptions">actionDone|flagNoExtractUi</item>
    </style>
</resources>
